<?xml version="1.0"?>
<!--
  Nano Desktop labwc configuration.

  Loaded via `labwc -C /etc/xdg/labwc`. Executables are referenced through
  /run/current-system/sw/bin/ (the system profile) rather than /nix/store/
  paths, so keybinds keep resolving across package updates and garbage
  collection. Every program referenced must be in environment.systemPackages
  so its symlink exists there.

  <default /> loads labwc's built-in keybinds (A-Tab window cycle, A-F4 close,
  A-Space window menu, W-Return terminal, W-<arrow> tiling, and the Audio /
  MonBrightness keys). The explicit binds below add the launcher, lock and
  screenshot keys, and override the volume/brightness keys to route through
  nano-osd (wpctl or amixer, per features.audioServer, + brightnessctl, with a
  self-replacing mako notification progress bar — no resident OSD daemon).

  There is no root menu. See the <mouse> section at the bottom.
-->
<labwc_config>

  <theme>
    <!-- NanoAdwaita ships the GNOME/Adwaita titlebar button icons (installed to
         /share/themes/NanoAdwaita/labwc via the nano-labwc-theme package). All
         colours/sizing still come from themerc-override, loaded afterwards. -->
    <name>NanoAdwaita</name>
    <icon>Tela-dark</icon>
    <cornerRadius>12</cornerRadius>
    <dropShadows>yes</dropShadows>
    <!-- GNOME layout: no buttons on the left; minimize, maximize, close right. -->
    <titlebar>
      <layout>:iconify,max,close</layout>
    </titlebar>
    <font place="ActiveWindow">
      <name>Adwaita Sans</name>
      <size>11</size>
    </font>
    <font place="InactiveWindow">
      <name>Adwaita Sans</name>
      <size>11</size>
    </font>
    <font place="MenuItem">
      <name>Adwaita Sans</name>
      <size>11</size>
    </font>
    <font place="OnScreenDisplay">
      <name>Adwaita Sans</name>
      <size>11</size>
    </font>
  </theme>

  <core>
    <!-- Let Xwayland exit as soon as its last client disconnects, instead of
         idling for the rest of the session. This is labwc's default, stated
         explicitly because the whole session is built to keep it asleep: the
         GDK/QT/SDL/CLUTTER backend variables make X-only apps hard-fail rather
         than silently start it, and the session runs no input method, so
         nothing connects on that side either. An idle Xwayland is ~11 MB RSS
         that this box has no use for. -->
    <xwaylandPersistence>no</xwaylandPersistence>
  </core>

  <placement>
    <policy>cascade</policy>
  </placement>

  <keyboard>
    <default />

    <!-- fuzzel launcher on Super+Space (plus F12 / Alt-F2). The Sfwbar Start
         button opens sfwbar's own native application menu; fuzzel is the
         keyboard-driven alternative. -->
    <keybind key="W-space">
      <action name="Execute" command="/run/current-system/sw/bin/fuzzel" />
    </keybind>
    <keybind key="F12">
      <action name="Execute" command="/run/current-system/sw/bin/fuzzel" />
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="/run/current-system/sw/bin/fuzzel" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="/run/current-system/sw/bin/foot" />
    </keybind>

    <!-- Screen lock. Starts the same user service that gates the session at
         boot (see programs.gtklock / systemd.user.services.gtklock in
         modules/session.nix) rather than running a second gtklock beside it,
         so there is one lock in the session however it was asked for — and
         pressing this while already locked is a no-op instead of an error. -->
    <keybind key="W-l">
      <action name="Execute" command="/run/current-system/sw/bin/systemctl --user start gtklock.service" />
    </keybind>

    <!-- Clipboard history and unicode/emoji picker. The pickers are
         fuzzel-based scripts that type the result back with wtype, so these
         are compositor keybinds — nothing needs the keypress to reach the
         focused application first. Both are no-ops unless
         features.clipboardHistory is on, which is what installs the two
         scripts. -->
    <keybind key="W-v">
      <action name="Execute" command="/run/current-system/sw/bin/nano-clipboard" />
    </keybind>
    <keybind key="W-period">
      <action name="Execute" command="/run/current-system/sw/bin/nano-unicode" />
    </keybind>

    <!-- Screenshots (grim/slurp via a small wrapper) -->
    <keybind key="Print">
      <action name="Execute" command="/run/current-system/sw/bin/nano-screenshot full" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="/run/current-system/sw/bin/nano-screenshot region" />
    </keybind>

    <!-- Volume / brightness → nano-osd (adjusts via wpctl or amixer, per
         features.audioServer, plus brightnessctl, and shows the level as a mako
         progress-bar notification that replaces itself in place — no resident
         OSD daemon) -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="/run/current-system/sw/bin/nano-osd volume-up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="/run/current-system/sw/bin/nano-osd volume-down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="/run/current-system/sw/bin/nano-osd volume-mute" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="/run/current-system/sw/bin/nano-osd mic-mute" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="/run/current-system/sw/bin/nano-osd brightness-up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="/run/current-system/sw/bin/nano-osd brightness-down" />
    </keybind>
  </keyboard>

  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
    </device>
  </libinput>

  <!-- No menu on the desktop background.

       There is no menu.xml in /etc/xdg/labwc either, but deleting it is not
       what removes the menu: with none found, labwc builds a built-in
       root-menu (Terminal / Reconfigure / Exit) and shows that instead. The
       menu goes away here, by unbinding the presses that summon it.

       All three, because labwc's defaults bind Left, Right AND Middle press
       on the desktop to root-menu — unbinding the right button alone would
       leave the same menu one left-click away. A <mousebind> with no <action>
       inside is labwc's way of dropping a binding; <default /> loads the rest
       of the defaults first, including the window-decoration bindings and the
       scroll-to-switch-workspace that stay.

       What was in that menu is not lost: the launcher menu on the panel
       enumerates every installed application, and carries the lock and power
       entries the root menu used to duplicate (see config/sfwbar). -->
  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Left" action="Press" />
      <mousebind button="Right" action="Press" />
      <mousebind button="Middle" action="Press" />
    </context>
  </mouse>

  <!-- Alt-Tab switcher. Releasing Alt commits to the highlighted window (labwc
       ends the cycle when the last modifier is released); Escape cancels and
       the arrow keys step through it. That release-to-commit path depends on
       every keyboard reporting no modifiers, so nothing in the session may hold
       a stale modifier. The one thing to watch is wtype, which the pickers
       invoke with matched -M/-m pairs so it never exits mid-chord.

       `show` belongs on <osd>, not here: the attribute on <windowSwitcher> is
       deprecated and makes labwc log a config error on every start. -->
  <windowSwitcher preview="yes" outlines="yes" order="focus">
    <osd show="yes" style="thumbnail" />
  </windowSwitcher>

</labwc_config>