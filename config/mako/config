# Nano Desktop mako notifications — modern Adwaita DARK, GNOME 3 style.
# Loaded via `mako --config /etc/xdg/mako/config` (mako only auto-reads
# ~/.config/mako/config, so the service points at this file explicitly — the
# same pattern as labwc -C and sfwbar -f). Colours track the desktop's
# libadwaita dark palette: #2e2e32 elevated surface, white text, the
# nanoDesktop.accentColor accent, #c01c28 destructive — matching the panel,
# menus and titlebars.

# Top-centre banners like GNOME Shell, above fullscreen windows.
anchor=top-center
layer=overlay
sort=-time
max-visible=5

# Bold summary over a lighter body, app icon on the left.
font=Adwaita Sans 11
markup=1
format=<b>%s</b>\n%b
icons=1
icon-location=left
max-icon-size=48
text-alignment=left
# Resolve named icons. mako does not read theme metadata, so it never follows
# an Inherits chain — every theme has to be listed by hand, here in the same
# order the chain would have walked: MoreWaita, then Adwaita, then the legacy
# set that carries the named full-colour icons GNOME 46 split out of it, then
# hicolor for each app's own branded icon.
#
# hicolor is listed even though mako appends a fallback of its own, because
# that fallback is the hardcoded literal /usr/share/icons/hicolor (icon.c),
# which does not exist on NixOS. Without the real path it is not a fallback
# at all.
#
# In practice the legacy theme answers nearly everything the desktop itself
# sends, and that is a property of mako's lookup rather than of the icon
# chain: it globs <theme>/*/*/<name>.* and reads the icon size out of the
# directory name with strtol, so a directory that is not a number — scalable,
# symbolic — parses as size 0 and is skipped. MoreWaita and Adwaita are
# almost entirely those two, so the volume, microphone and battery glyphs
# come from the fixed-size legacy dirs. They are named the same either way;
# only this file's ordering has to know.
#
# display-brightness is the exception, and it is why MoreWaita leads the list
# rather than riding along for symmetry: no generation of Adwaita draws that
# name outside symbolic/, so nanoIconTheme puts a copy in a sized directory
# (48x48/status) purely so this lookup can find it. See the comment there —
# the size is in the file as well as the path, because mako scales an icon
# down to fit and never up.
icon-path=/run/current-system/sw/share/icons/MoreWaita:/run/current-system/sw/share/icons/Adwaita:/run/current-system/sw/share/icons/AdwaitaLegacy:/run/current-system/sw/share/icons/hicolor

# Rounded Adwaita card: elevated dark surface, hairline border.
background-color=#2e2e32
text-color=#ffffff
border-color=#1c1c1f
border-size=1
border-radius=12
width=420
height=120
margin=10
padding=14
progress-color=over #@ACCENT@

# Group repeat notifications from one app, GNOME-style.
group-by=app-name

# Auto-dismiss: notifications expire one minute (60000 ms) after arriving.
default-timeout=60000

# Low-urgency notifications read as muted; high-urgency get the destructive
# accent border but still auto-expire after the minute above.
[urgency=low]
text-color=#9a9a9a

[urgency=high]
border-color=#c01c28
