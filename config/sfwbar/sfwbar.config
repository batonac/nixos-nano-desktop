#Api2
#
# Nano Desktop Sfwbar panel — classic Windows-style bottom bar.
# Launched via `sfwbar -f /etc/xdg/sfwbar/sfwbar.config`; styling is auto-loaded
# from the sibling sfwbar.css. Included *.widget files (winops, volume,
# battery, network, bluez, clock) are resolved from Sfwbar's bundled data dir;
# network/bluez run as in-process modules, so no resident tray applet is needed
# for either.
# Quick-launch commands are referenced via the system profile so they survive
# updates / GC (each program must be in environment.systemPackages).

# Search path for Sfwbar's own bundled icons plus system icon themes.
# The system profile links all icon themes to /run/current-system/sw/share/icons.
# Tela-dark first for themed status/utility glyphs (Tela-light backs it
# with the full-colour app + mimetype set); hicolor carries each app's
# own branded icon; pixmaps + Sfwbar's bundled icons round it out.
Set ImagePath = "/run/current-system/sw/share/icons/Tela-dark:/run/current-system/sw/share/icons/Tela-light:/run/current-system/sw/share/icons/hicolor:/run/current-system/sw/share/pixmaps:/run/current-system/sw/share/sfwbar/icons"
Set ThicknessHint = "20px"

# labwc owns Alt-Tab window cycling; disable Sfwbar's own task switcher.
switcher {
  disable = true
}

# Window placer (used by Sfwbar's placement helpers)
placer {
  xorigin = 5
  yorigin = 5
  xstep = 5
  ystep = 5
  children = true
}

# Right-click-on-taskbar window operations menu
include "winops.widget"

# Native application menu. The appmenu module enumerates the freedesktop
# .desktop files via GIO (g_app_info_get_all) and self-categorises them into
# the "app_menu_system" menu, which the Start button below opens. NOTE: GIO
# *rejects* any .desktop file whose Exec= binary is not findable in $PATH, so
# the sfwbar service must run with a real PATH (see the session services'
# `path` setting in modules/session.nix) — with a stripped PATH this menu
# renders empty.
module("appmenu")

# Lock and power, appended below the application categories.
#
# This is the only menu on the desktop now — there is no root menu on the
# background any more (see the <mouse> section of config/labwc/rc.xml) — so
# the things that menu was actually used for live here, where someone
# looking for them will already be looking.
#
# AppMenuItemBottom is the appmenu module's own API for this and is what keeps
# the items attached: the module owns app_menu_system and rebuilds it as
# .desktop files come and go, so items declared in a `menu` block of our own
# would be rebuilt away. "Label%icon" is sfwbar's icon syntax; the names
# resolve from Tela-dark on ImagePath above.
#
# Called from action[0] on the Start button below, which sfwbar runs once at
# startup — module actions need somewhere to be invoked from, and the button
# that opens the menu is the honest place for the ones that fill it.
#
# Lock goes through the same user service as Super+L rather than running
# gtklock directly, so there is one lock in the session however it is asked
# for. Power goes through logind, which grants these to the user holding the
# active local session without a polkit prompt. Log Out ends the compositor
# (labwc --exit signals $LABWC_PID, which labwc puts in the systemd user
# manager's environment at startup, so it is in ours); the nano-desktop
# service restarts it, and gtklock is waiting again — which is what logging
# out should mean on a machine whose login screen is the lock screen.
#
# The items come out sorted, not in the order written here.
function NanoMenuInit() {
  AppMenuItemBottom("Lock Screen%system-lock-screen",
    "/run/current-system/sw/bin/systemctl --user start gtklock.service");
  AppMenuItemBottom("Log Out%system-log-out",
    "/run/current-system/sw/bin/labwc --exit");
  AppMenuItemBottom("Suspend%system-suspend",
    "/run/current-system/sw/bin/systemctl suspend");
  AppMenuItemBottom("Restart%system-reboot",
    "/run/current-system/sw/bin/systemctl reboot");
  AppMenuItemBottom("Shut Down%system-shutdown",
    "/run/current-system/sw/bin/systemctl poweroff");
}

# Volume control definitions (scanners + widget). Injected from
# modules/desktop.nix so
# they can follow features.audioServer: the native pulse/pipewire `volume`
# module when the audio server is on, or an amixer-driven ALSA widget when it
# is off (apulse/pressureaudio, no server). Empty in the pulse case.
@VOLUME_DEFS@

bar {
  edge = "bottom"
  layer = "top"
  exclusive_zone = "auto"

  # Start button → the appmenu-populated application menu (module loaded above;
  # this inlines sfwbar's bundled startmenu.widget so the icon can be the NixOS
  # snowflake — `nix-snowflake` from the nixos-icons package, resolved via the
  # hicolor dir on ImagePath). The popup is painted dark by the `menu {}` rules
  # in sfwbar.css. fuzzel remains the keyboard launcher on Super+Space (see
  # labwc/rc.xml). action[0] runs once at startup and appends the lock/power
  # entries — see NanoMenuInit above.
  button {
    style = "startmenu"
    value = "nix-snowflake"
    tooltip = "Applications"
    action[0] = NanoMenuInit()
    action = Menu("app_menu_system")
  }

  # Quick launch. No terminal here on purpose: foot is still installed, on
  # Super+Return and in the menu under System Tools, but a terminal pinned
  # beside the browser and the file manager sets the wrong expectation about
  # what this desktop asks of the person using it.
  button {
    style = "launcher"
    value = "web-browser"
    tooltip = "Web Browser"
    action = Exec("/run/current-system/sw/bin/firefox")
  }
  button {
    style = "launcher"
    value = "system-file-manager"
    tooltip = "Files"
    action = Exec("/run/current-system/sw/bin/pcmanfm")
  }

  # Open windows (wlr-foreign-toplevel)
  taskbar {
    style = "taskbar"
    rows = 1
    tooltips = true
    icons = true
    labels = true
    sort = false
    action[RightClick] = Menu("winops")
    action[Drag] = Focus()
  }

  # Elastic spacer pushing the tray/clock to the right edge
  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }

  # Volume widget — placed here, defined by the injected block above (from
  # flake.nix, per features.audioServer): the native pulse/pipewire volume
  # module, or an amixer-driven ALSA button. Scroll to adjust, click for mixer.
  @VOLUME_WIDGET@

  # Battery status widget
  widget "battery.widget"

  # Native network status + wifi picker (network + wifi-iwd modules, in
  # process — no ~50 MB resident applet). The button self-hides when no
  # interface is
  # up; the icon tracks wifi signal strength (or shows a wired glyph), the
  # tooltip lists interface/ip/gateway details, and clicking opens the wifi
  # network list with connect/disconnect/forget and a passphrase prompt.
  # iwgtk stays available from the app menu for hidden networks, WPS and
  # per-adapter settings.
  #
  # No backend selection needed here: upstream's wifi.widget (pulled in by
  # network.widget) loads wifi-nm and wifi-iwd side by side, and sfwbar
  # arbitrates at runtime — each module watches its daemon's bus name and
  # module_interface_select() activates whichever provider is actually
  # present. The panel follows the system, so switching daemons costs nothing
  # on this side. The status half is daemon-agnostic regardless: the network
  # module reads netlink directly, not D-Bus.
  widget "network.widget"

  # Native bluetooth status + pairing popup (bluez module, in process — no
  # ~100 MB resident applet/tray pair). Talks to bluetoothd
  # directly and self-hides when no adapter is present. Click lists
  # paired/available devices with pair/connect/remove; right-click gives
  # power/discoverable/scan. blueman-manager stays available from the app
  # menu (D-Bus activated on demand) for anything beyond that.
  widget "bluez.widget"

  # SNI system tray — empty by default (no resident applets anymore); hosts
  # status icons for user-launched apps that provide them.
  tray {
    rows = 1
  }

  # Clock
  widget "clock.widget" {
    disable = false
    time_format = "%a, %B, %-d  %-I:%M %p"
    tooltip_format = "%-I:%M %p%n%A, %x"
    week_starts_on_sunday = true
  }
}
